def _تثبيت_ذاتي():
    مسار_حالي = os.path.abspath(__file__)
    هدف = os.path.expanduser("~/.zerotik/zerotik.py")
    if os.path.abspath(هدف) == مسار_حالي:
        return
    if os.path.exists(هدف):
        try:
            if os.path.getmtime(هدف) >= os.path.getmtime(مسار_حالي):
                return
        except Exception:
            pass
    if "--no-install" in sys.argv:
        return
    try:
        os.makedirs(os.path.expanduser("~/.zerotik"), exist_ok=True)
        os.makedirs(os.path.expanduser("~/.local/bin"), exist_ok=True)
        shutil.copy2(مسار_حالي, هدف)
        غلاف = os.path.expanduser("~/.local/bin/zerotik")
        with open(غلاف, "w") as f:
            f.write('#!/bin/sh\nexec python3 "$HOME/.zerotik/zerotik.py" "$@"\n')
        os.chmod(غلاف, 0o755)
        bin_dir = os.path.expanduser("~/.local/bin")
        if bin_dir not in os.environ.get("PATH", ""):
            for rc in ("~/.bashrc", "~/.zshrc", "~/.profile"):
                مسار_rc = os.path.expanduser(rc)
                if os.path.exists(مسار_rc):
                    try:
                        with open(مسار_rc) as f:
                            if bin_dir in f.read():
                                continue
                        with open(مسار_rc, "a") as f:
                            f.write(f'\nexport PATH="$HOME/.local/bin:$PATH"\n')
                    except Exception:
                        pass
    except Exception:
        pass

_تثبيت_ذاتي()

