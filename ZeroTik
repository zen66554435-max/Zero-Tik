    os.makedirs(مجلد_المخرجات, exist_ok=True)
    html = توليد_HTML(بيانات, نوع)
    نظيف = re.sub(r'[^A-Za-z0-9_\-]', '_', هدف.lstrip("@#"))
    ختم = datetime.now().strftime("%Y%m%d_%H%M%S")
    if صيغة == "pdf":
        مسار = os.path.join(مجلد_المخرجات, f"{نظيف}_{نوع}_{ختم}.pdf")
        if توليد_PDF(html, مسار):
            return مسار
        تحذير("PDF فشل — حفظ HTML")
    مسار = os.path.join(مجلد_المخرجات, f"{نظيف}_{نوع}_{ختم}.html")
    with open(مسار, "w", encoding="utf-8") as f:
        f.write(html)
    return مسار

