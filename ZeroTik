def صامت(أمر, مهلة=180):
    """ينفّذ أمراً بصمت، يرجع (نجاح، مخرجات)"""
    try:
        ن = subprocess.run(أمر, shell=True, capture_output=True, text=True, timeout=مهلة)
        return ن.returncode == 0, (ن.stdout + ن.stderr).strip()
    except Exception as e:
        return False, str(e)

def بايثون_متاح():
    return sys.version_info >= (3, 8)

def playwright_متاح():
    try:
        import playwright  # noqa
        return True
    except ImportError:
        return False

def chromium_متاح():
    # Playwright's bundled chromium
    مسارات = [
        os.path.expanduser("~/.cache/ms-playwright"),
        os.path.expanduser("~/Library/Caches/ms-playwright"),
        os.environ.get("PLAYWRIGHT_BROWSERS_PATH", ""),
    ]
    for م in مسارات:
        if م and os.path.isdir(م) and any("chromium" in x.lower() for x in os.listdir(م)):
            return True
    # system chromium
    for اسم in ("chromium", "chromium-browser", "google-chrome", "chrome"):
        if shutil.which(اسم):
            return True
    # termux
    for مسار in (
        "/data/data/com.termux/files/usr/bin/chromium",
        "/data/data/com.termux/files/usr/bin/chromium-browser",
    ):
        if os.path.exists(مسار):
            return True
    return False

def pip_تثبيت(حزمة):
    مقترحات = [
        f"{sys.executable} -m pip install --quiet --disable-pip-version-check {حزمة}",
        f"pip3 install --quiet {حزمة}",
        f"pip install --quiet {حزمة}",
    ]
    for أمر in مقترحات:
        ok, _ = صامت(أمر)
        if ok:
            return True
    return False

def chromium_نظام():
    for اسم in ("chromium", "chromium-browser", "google-chrome", "chrome"):
        p = shutil.which(اسم)
        if p:
            return p
    for مسار in (
        "/data/data/com.termux/files/usr/bin/chromium",
        "/data/data/com.termux/files/usr/bin/chromium-browser",
    ):
        if os.path.exists(مسار):
            return مسار
    return None

def تثبيت_نظام():
    """يحاول تثبيت chromium عبر مدير الحزم المناسب، بصمت"""
    مقترحات = []
    if shutil.which("pkg"):  # termux
        مقترحات.append("pkg install -y chromium")
    if shutil.which("apt"):
        مقترحات.append("sudo apt install -y chromium || apt install -y chromium")
        مقترحات.append("sudo apt install -y chromium-browser || apt install -y chromium-browser")
    if shutil.which("dnf"):
        مقترحات.append("sudo dnf install -y chromium")
    if shutil.which("pacman"):
        مقترحات.append("sudo pacman -S --noconfirm chromium")
    if shutil.which("apk"):
        مقترحات.append("apk add --no-cache chromium")
    for أمر in مقترحات:
        ok, _ = صامت(أمر, مهلة=600)
        if ok and chromium_نظام():
            return True
    return False

def تهيئة_بيئة():
    """
    يشغّل نفسه بصمت. يرجع (playwright_جاهز, chromium_path).
    إن فشل كل شيء، يرجع (False, None) دون أن يطبع شيئاً.
    """
    if not بايثون_متاح():
        return False, None

    # playright
    if not playwright_متاح():
        if not pip_تثبيت("playwright"):
            return False, None

    # chromium
    مسار = chromium_نظام()
    if مسار:
        return True, مسار

    # playwright bundled
    ok, _ = صامت(f"{sys.executable} -m playwright install chromium", مهلة=900)
    if ok and chromium_متاح():
        return True, None  # None = playwright يستخدم مساره

    # نظام
    if تثبيت_نظام():
        مسار = chromium_نظام()
        if مسار:
            return True, مسار

    return False, None

