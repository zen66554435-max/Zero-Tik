    معلومات = نطاق.get("webapp.user-detail", {}).get("userInfo", {})
    مستخدم_ب = معلومات.get("user") or {}
    إحصاءات = معلومات.get("stats") or {}
    عناصر = معلومات.get("itemList") or []
    if not مستخدم_ب:
        وحدة = حالة.get("UserModule", {})
        مستخدم_ب = وحدة.get("users", {}).get(مستخدم, {})
        إحصاءات = وحدة.get("stats", {}).get(مستخدم, {})
        عناصر = وحدة.get("items", [])
    نتيجة = {
        "username": مستخدم, "id": مستخدم_ب.get("id"),
        "nickname": مستخدم_ب.get("nickname"),
        "signature": مستخدم_ب.get("signature"),
        "verified": مستخدم_ب.get("verified"),
        "privateAccount": مستخدم_ب.get("privateAccount"),
        "region": مستخدم_ب.get("region"),
        "createTime": مستخدم_ب.get("createTime"),
        "avatar": مستخدم_ب.get("avatarLarger") or مستخدم_ب.get("avatarMedium"),
        "followers": إحصاءات.get("followerCount"),
        "following": إحصاءات.get("followingCount"),
        "likes": إحصاءات.get("heartCount") or إحصاءات.get("heart"),
        "videos": إحصاءات.get("videoCount"),
        "diggCount": إحصاءات.get("diggCount"),
        "friendCount": إحصاءات.get("friendCount"),
    }
    فيديوهات = []
    for ع in عناصر:
        إ = ع.get("stats", {})
        فيديوهات.append({
            "id": ع.get("id"), "desc": ع.get("desc"),
            "createTime": ع.get("createTime"),
            "playCount": إ.get("playCount"), "diggCount": إ.get("diggCount"),
            "commentCount": إ.get("commentCount"), "shareCount": إ.get("shareCount"),
            "collectCount": إ.get("collectCount"),
            "duration": (ع.get("video") or {}).get("duration"),
        })
    نتيجة["recentVideos"] = فيديوهات
    return نتيجة

# ═══════════ Playwright مع تجاوز صامت ═══════════

def اعتراض_عميق(رابط_بداية, تمريرات=12, انتظار=1500, مهلة=40, chromium_path=None):
    from playwright.sync_api import sync_playwright
    مسؤول = {}
    إعداد_الإطلاق = {
        "headless": True,
        "args": ["--no-sandbox", "--disable-dev-shm-usage", "--disable-gpu"],
    }
    if chromium_path:
        إعداد_الإطلاق["executable_path"] = chromium_path
    with sync_playwright() as p:
        متصفح = p.chromium.launch(**إعداد_الإطلاق)
        سياق = متصفح.new_context(
            user_agent=random.choice(وكلاء_المستخدم),
            locale="ar-SA",
            viewport={"width": 1280, "height": 2000},
        )
        صفحة = سياق.new_page()
        def عند_رد(رد):
            u = رد.url
            if "tiktok.com/api/" in u:
                try:
                    اسم = u.split("?")[0].rstrip("/").rsplit("/", 1)[-1]
                    مسؤول[اسم] = رد.json()
                except Exception:
                    pass
        صفحة.on("response", عند_رد)
        صفحة.goto(رابط_بداية, wait_until="domcontentloaded", timeout=مهلة * 1000)
        صفحة.wait_for_timeout(3000)
        for _ in range(تمريرات):
            صفحة.mouse.wheel(0, 2500)
            صفحة.wait_for_timeout(انتظار)
            try:
                زر = صفحة.query_selector('button[aria-label="Close"], [data-e2e="modal-close-inner-button"]')
                if زر: زر.click()
            except Exception:
                pass
        متصفح.close()
    return مسؤول

