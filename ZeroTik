        نتيجة.append({
            "uniqueId": uid,
            "nickname": بيانات.get("nickname"),
            "id": بيانات.get("id"),
            "region": بيانات.get("region"),
            "signature": بيانات.get("signature"),
            "verified": بيانات.get("verified"),
            "avatar": بيانات.get("avatarLarger") or بيانات.get("avatarMedium"),
        })
    return نتيجة

def استخراج_المنشن(نص):
    if not نص: return []
    return list(set(re.findall(r'@([A-Za-z0-9_.]{2,24})', نص)))

أوزان_الإشارات = {
    "متبادل": 15, "تعليق_متكرر": 20, "منشن_متكرر": 15,
    "دويتو": 15, "ستيتش": 10, "نفس_المنطقة": 5,
    "رد_على_تعليقه": 10, "ذكر_في_السيرة": 10, "تفاعل_متبادل": 10,
}

def درجة_الصلة(شخص_uid, بيانات):
    مساهمات = []
    مجموع = 0
    if بيانات.get("متبادل"):
        مساهمات.append({"إشارة": "متبادل", "نقاط": أوزان_الإشارات["متبادل"], "سبب": "يتابعك وتتابعه"})
        مجموع += أوزان_الإشارات["متبادل"]
    عدد_تعليقات = بيانات.get("عدد_التعليقات", 0)
    if عدد_تعليقات >= 3:
        نقاط = min(int(أوزان_الإشارات["تعليق_متكرر"] * (عدد_تعليقات / 30) ** 0.5 * 1.5), أوزان_الإشارات["تعليق_متكرر"])
        نقاط = max(نقاط, 5)
        مساهمات.append({"إشارة": "تعليق_متكرر", "نقاط": نقاط, "سبب": f"{عدد_تعليقات} تعليق عندك"})
        مجموع += نقاط
    عدد_منشن = بيانات.get("عدد_المنشن", 0)
    if عدد_منشن >= 2:
        نقاط = min(int(أوزان_الإشارات["منشن_متكرر"] * (عدد_منشن / 10) ** 0.5 * 1.5), أوزان_الإشارات["منشن_متكرر"])
        نقاط = max(نقاط, 3)
        مساهمات.append({"إشارة": "منشن_متكرر", "نقاط": نقاط, "سبب": f"{عدد_منشن} إشارة متبادلة"})
        مجموع += نقاط
    عدد_دويتو = بيانات.get("عدد_دويتو", 0)
    if عدد_دويتو >= 1:
        نقاط = min(أوزان_الإشارات["دويتو"] + (عدد_دويتو - 1) * 3, 25)
        مساهمات.append({"إشارة": "دويتو", "نقاط": نقاط, "سبب": f"{عدد_دويتو} دويتو"})
        مجموع += نقاط
    عدد_ستيتش = بيانات.get("عدد_ستيتش", 0)
    if عدد_ستيتش >= 1:
        نقاط = min(أوزان_الإشارات["ستيتش"] + (عدد_ستيتش - 1) * 2, 20)
        مساهمات.append({"إشارة": "ستيتش", "نقاط": نقاط, "سبب": f"{عدد_ستيتش} ستيتش"})
        مجموع += نقاط
    if بيانات.get("نفس_المنطقة"):
        مساهمات.append({"إشارة": "نفس_المنطقة", "نقاط": أوزان_الإشارات["نفس_المنطقة"], "سبب": f"منطقة: {بيانات.get('المنطقة')}"})
        مجموع += أوزان_الإشارات["نفس_المنطقة"]
    عدد_ردود = بيانات.get("عدد_الردود_عليه", 0)
    if عدد_ردود >= 2:
        نقاط = min(3 + عدد_ردود, أوزان_الإشارات["رد_على_تعليقه"])
        مساهمات.append({"إشارة": "رد_على_تعليقه", "نقاط": نقاط, "سبب": f"رددت عليه {عدد_ردود} مرة"})
        مجموع += نقاط
    if بيانات.get("في_السيرة"):
        مساهمات.append({"إشارة": "ذكر_في_السيرة", "نقاط": أوزان_الإشارات["ذكر_في_السيرة"], "سبب": "مذكور في السيرة"})
        مجموع += أوزان_الإشارات["ذكر_في_السيرة"]
    if بيانات.get("تفاعل_متبادل"):
        مساهمات.append({"إشارة": "تفاعل_متبادل", "نقاط": أوزان_الإشارات["تفاعل_متبادل"], "سبب": "تفاعل متبادل"})
        مجموع += أوزان_الإشارات["تفاعل_متبادل"]
    المجموع_الأقصى = sum(أوزان_الإشارات.values())
    درجة = min(int((مجموع / المجموع_الأقصى) * 100), 100)
    return درجة, مساهمات

def تحليل_الشبكة(الهدف, متابعون, متابَعون, فيديوهات):
    تحليل = {
        "الهدف": الهدف,
        "عدد_المتابعين": len(متابعون),
        "عدد_المتابَعين": len(متابَعون),
        "متبادلون": [],
        "أعلى_المعلّقين": [],
        "أكثر_المذكورين": [],
        "شركاء_الدويتو": [],
        "درجات_الصلة": [],
        "المجموعات": [],
    }
    معرفات_متابعين = {u["uniqueId"] for u in متابعون if u.get("uniqueId")}
    معرفات_متابَعين = {u["uniqueId"] for u in متابَعون if u.get("uniqueId")}
    متبادل = معرفات_متابعين & معرفات_متابَعين
    خريطة_متابعين = {u["uniqueId"]: u for u in متابعون if u.get("uniqueId")}
    خريطة_متابَعين = {u["uniqueId"]: u for u in متابَعون if u.get("uniqueId")}
    تحليل["متبادلون"] = [خريطة_متابعين[i] for i in متبادل]
    عداد_تعليقات = {}
    عداد_منشن_من_الهدف = {}
    عداد_منشن_من_هم = {}
    عداد_دويتو = {}
    عداد_ستيتش = {}
    عداد_ردود_الهدف_عليهم = {}
    في_السيرة = set()
    for م in استخراج_المنشن(الهدف.get("signature")):
        في_السيرة.add(م)
    تعليق_على_من = defaultdict(set)
    for ف in فيديوهات:
        for م in استخراج_المنشن(ف.get("desc")):
            if م != الهدف.get("username"):
                عداد_منشن_من_الهدف[م] = عداد_منشن_من_الهدف.get(م, 0) + 1
        for ت in ف.get("comments", []):
            uid = (ت.get("author") or {}).get("uniqueId")
            if not uid or uid == الهدف.get("username"): continue
            عداد_تعليقات[uid] = عداد_تعليقات.get(uid, 0) + 1
            for م in استخراج_المنشن(ت.get("text")):
                if م == الهدف.get("username"):
                    عداد_منشن_من_هم[uid] = عداد_منشن_من_هم.get(uid, 0) + 1
                else:
                    تعليق_على_من[uid].add(م)
            for رد in ت.get("replies", []):
                رد_uid = (رد.get("author") or {}).get("uniqueId")
                if رد_uid == الهدف.get("username"):
                    عداد_ردود_الهدف_عليهم[uid] = عداد_ردود_الهدف_عليهم.get(uid, 0) + 1
        for ع in ف.get("علاقات", []):
            ش = ع.get("مع")
            if not ش or ش == الهدف.get("username"): continue
            if ع.get("النوع") == "دويتو":
                عداد_دويتو[ش] = عداد_دويتو.get(ش, 0) + 1
            else:
                عداد_ستيتش[ش] = عداد_ستيتش.get(ش, 0) + 1
    مرشحون = set()
    مرشحون.update(عداد_تعليقات)
    مرشحون.update(عداد_منشن_من_الهدف)
    مرشحون.update(عداد_منشن_من_هم)
    مرشحون.update(عداد_دويتو)
    مرشحون.update(عداد_ستيتش)
    مرشحون.update(عداد_ردود_الهدف_عليهم)
    مرشحون.update(في_السيرة)
    مناطق_المتابعين = {u["uniqueId"]: u.get("region") for u in متابعون}
    تحليل["أعلى_المعلّقين"] = sorted(
        [{"uniqueId": k, "عدد": v} for k, v in عداد_تعليقات.items()],
        key=lambda x: -x["عدد"]
    )[:20]
    تحليل["أكثر_المذكورين"] = sorted(
        [{"uniqueId": k, "عدد": v} for k, v in {**عداد_منشن_من_الهدف, **عداد_منشن_من_هم}.items()],
        key=lambda x: -x["عدد"]
    )[:20]
    تحليل["شركاء_الدويتو"] = sorted(
        [{"uniqueId": k, "عدد": v} for k, v in {**عداد_دويتو, **عداد_ستيتش}.items()],
        key=lambda x: -x["عدد"]
    )[:20]
    درجات = []
    for uid in مرشحون:
        بيانات = {
            "متبادل": uid in متبادل,
            "عدد_التعليقات": عداد_تعليقات.get(uid, 0),
            "عدد_المنشن": عداد_منشن_من_الهدف.get(uid, 0) + عداد_منشن_من_هم.get(uid, 0),
            "عدد_دويتو": عداد_دويتو.get(uid, 0),
            "عدد_ستيتش": عداد_ستيتش.get(uid, 0),
            "نفس_المنطقة": (مناطق_المتابعين.get(uid) == الهدف.get("region")) if الهدف.get("region") and مناطق_المتابعين.get(uid) else False,
            "المنطقة": مناطق_المتابعين.get(uid) or "—",
            "عدد_الردود_عليه": عداد_ردود_الهدف_عليهم.get(uid, 0),
            "في_السيرة": uid in في_السيرة,
            "تفاعل_متبادل": uid in عداد_تعليقات and عداد_منشن_من_هم.get(uid, 0) > 0,
        }
        درجة, مساهمات = درجة_الصلة(uid, بيانات)
        if درجة > 0:
            درجات.append({
                "uniqueId": uid,
                "nickname": (خريطة_متابعين.get(uid) or خريطة_متابَعين.get(uid) or {}).get("nickname"),
                "درجة": درجة,
                "مساهمات": مساهمات,
            })
    درجات.sort(key=lambda x: -x["درجة"])
    تحليل["درجات_الصلة"] = درجات[:25]
    مجموعات = defaultdict(list)
    for شخص, يذكر in تعليق_على_من.items():
        for هدف_منشن in يذكر:
            if هدف_منشن in تعليق_على_من:
                زوج = tuple(sorted([شخص, هدف_منشن]))
                مجموعات[زوج].append(1)
    تحليل["المجموعات"] = [
        {"أ": a, "ب": b, "عدد_تبادل": len(v)}
        for (a, b), v in مجموعات.items() if len(v) >= 2
    ][:15]
    return تحليل

def ملف_معلّق(uid, فيديوهات, مستخدم_الهدف):
    تعليقاته = []
    فيديوهات_علّق_عليها = {}
    for ف in فيديوهات:
        fid = ف.get("id")
        وصف = (ف.get("desc") or "")[:80]
        for ت in ف.get("comments", []):
            مؤلف = (ت.get("author") or {})
            if مؤلف.get("uniqueId") != uid: continue
            ردود_الهدف = []
            for رد in ت.get("replies", []):
                if (رد.get("author") or {}).get("uniqueId") == مستخدم_الهدف:
                    ردود_الهدف.append(رد.get("text"))
            عنصر = {
                "فيديو_id": fid, "فيديو_وصف": وصف,
                "نص": ت.get("text"), "إعجابات": ت.get("likesCount"),
                "ردود_عليه": ت.get("replyCount"), "وقت": ت.get("createTime"),
                "رد_الهدف_عليه": ردود_الهدف if ردود_الهدف else None,
            }
            تعليقاته.append(عنصر)
            if fid not in فيديوهات_علّق_عليها:
                فيديوهات_علّق_عليها[fid] = {"id": fid, "وصف": وصف, "عدد_تعليقاته": 0, "تعليقاته_هنا": []}
            فيديوهات_علّق_عليها[fid]["عدد_تعليقاته"] += 1
            فيديوهات_علّق_عليها[fid]["تعليقاته_هنا"].append(ت.get("text"))
    إجمالي_إعجابات = sum((ت.get("إعجابات") or 0) for t in تعليقاته)
    عدد_ردود_الهدف = sum(1 for ت in تعليقاته if ت.get("رد_الهدف_عليه"))
    أوقات = [ت["وقت"] for ت in تعليقاته if ت.get("وقت")]
    النطاق_الزمني = (min(أوقات), max(أوقات)) if أوقات else None
    إحصاءات = {
        "uniqueId": uid,
        "عدد_التعليقات": len(تعليقاته),
        "عدد_الفيديوهات_المختلفة": len(فيديوهات_علّق_عليها),
        "إجمالي_الإعجابات_على_تعليقاته": إجمالي_إعجابات,
        "متوسط_الإعجابات_لكل_تعليق": round(إجمالي_إعجابات / len(تعليقاته), 1) if تعليقاته else 0,
        "عدد_مرات_رد_الهدف_عليه": عدد_ردود_الهدف,
        "نطاق_زمني": النطاق_الزمني,
        "أكثر_فيديو_علّق_عليه": max(فيديوهات_علّق_عليها.values(), key=lambda x: x["عدد_تعليقاته"]) if فيديوهات_علّق_عليها else None,
    }
    return {
        "الإحصاءات": إحصاءات,
        "التعليقات_بالتفصيل": sorted(تعليقاته, key=lambda x: x.get("وقت") or 0, reverse=True),
        "الفيديوهات_التي_علّق_عليها": sorted(فيديوهات_علّق_عليها.values(), key=lambda x: -x["عدد_تعليقاته"]),
    }

كلمات_إيجابية = {"رهيب","رائع","حلو","جميل","ممتاز","شكرا","مبروك","أحبك","حبيبي","قوي","مبدع","عظيم","أفضل","نجاح","فخر","الله","يبارك","يسعدك","تستاهل","ابداع","كفو","زين","طيب","عسل"}
كلمات_سلبية = {"سيء","زفت","خرا","مقرف","سخيف","فاشل","كره","تكره","مزعج","سامج","تعبت","ملل","قبيح","سيئه","ضعيف","ممل","خايس","بايعها","انقلع"}

def نبرة_نص(نص):
    if not نص: return 0
    إيج = sum(1 for ك in كلمات_إيجابية if ك in نص)
    سل = sum(1 for ك in كلمات_سلبية if ك in نص)
    return إيج - سل

def تحليل_نبرة(فيديوهات):
    مجموع = 0
    إيجابي = 0
    سلبي = 0
    محايد = 0
    for ف in فيديوهات:
        for ت in ف.get("comments", []):
            ن = نبرة_نص(ت.get("text"))
            مجموع += ن
            if ن > 0: إيجابي += 1
            elif ن < 0: سلبي += 1
            else: محايد += 1
    الإجمالي = إيجابي + سلبي + محايد
    return {
        "إيجابي": إيجابي, "سلبي": سلبي, "محايد": محايد,
        "النسبة_الإيجابية": round(إيجابي / الإجمالي * 100, 1) if الإجمالي else 0,
        "النسبة_السلبية": round(سلبي / الإجمالي * 100, 1) if الإجمالي else 0,
        "الدرجة_العامة": "إيجابي" if مجموع > 0 else ("سلبي" if مجموع < 0 else "محايد"),
    }

def تحليل_أوقات(فيديوهات, مستخدم_الهدف):
    خريطة = defaultdict(int)
    نطاقات = defaultdict(int)
    for ف in فيديوهات:
        for ت in ف.get("comments", []):
            if (ت.get("author") or {}).get("uniqueId") != مستخدم_الهدف: continue
            وقت = ت.get("createTime")
            if not وقت: continue
            try:
                dt = datetime.fromtimestamp(وقت)
                خريطة[dt.hour] += 1
                if dt.hour < 6: نطاقات["فجر"] += 1
                elif dt.hour < 12: نطاقات["صباح"] += 1
                elif dt.hour < 18: نطاقات["ظهر"] += 1
                else: نطاقات["مساء"] += 1
            except Exception: pass
    return {"خريطة_الساعات": dict(خريطة), "النطاقات": dict(نطاقات)}

def كشف_وهمي(متابعون):
    نتائج = []
    for u in متابعون:
        علامات = []
        نقاط = 0
        nickname = (u.get("nickname") or "")
        if len(nickname) < 3 or re.match(r'^[a-z0-9_]{8,}$', nickname, re.I):
            علامات.append("اسم عشوائي"); نقاط += 25
        if not u.get("avatar"):
            علامات.append("بلا صورة"); نقاط += 20
        if not u.get("signature"):
            علامات.append("بلا سيرة"); نقاط += 10
        if u.get("verified") is False:
            نقاط += 5
        if نقاط >= 30:
            نتائج.append({
                "uniqueId": u.get("uniqueId"),
                "nickname": nickname,
                "احتمال_وهمي": min(نقاط, 95),
                "علامات": علامات,
            })
    نتائج.sort(key=lambda x: -x["احتمال_وهمي"])
    return نتائج[:30]

def ملف_فردي_كامل(uid, فيديوهات, مستخدم_الهدف, متابعون=None, متابَعون=None):
    ملف = ملف_معلّق(uid, فيديوهات, مستخدم_الهدف)
    إحصاءات_تعليقات = ملف["الإحصاءات"]
    منشن_هو_لهم = {}
    عدد_منشن_للهدف = 0
    for ت in ملف["التعليقات_بالتفصيل"]:
        for م in استخراج_المنشن(ت["نص"]):
            if م == مستخدم_الهدف:
                عدد_منشن_للهدف += 1
            else:
                منشن_هو_لهم[م] = منشن_هو_لهم.get(م, 0) + 1
    منشن_هو_لهم = sorted([{"uniqueId": k, "عدد": v} for k, v in منشن_هو_لهم.items()], key=lambda x: -x["عدد"])
    من_يذكره = {}
    for ف in فيديوهات:
        for ت in ف.get("comments", []):
            مؤلف = (ت.get("author") or {}).get("uniqueId")
            if not مؤلف or مؤلف == uid: continue
            if uid in استخراج_المنشن(ت.get("text")):
                من_يذكره[مؤلف] = من_يذكره.get(مؤلف, 0) + 1
    من_يذكره = sorted([{"uniqueId": k, "عدد": v} for k, v in من_يذكره.items()], key=lambda x: -x["عدد"])
    بيانات_الصلة = {
        "متبادل": False, "عدد_التعليقات": إحصاءات_تعليقات["عدد_التعليقات"],
        "عدد_المنشن": عدد_منشن_للهدف, "عدد_دويتو": 0, "عدد_ستيتش": 0,
        "نفس_المنطقة": False, "المنطقة": "—",
        "عدد_الردود_عليه": إحصاءات_تعليقات["عدد_مرات_رد_الهدف_عليه"],
        "في_السيرة": False, "تفاعل_متبادل": False,
    }
    درجة, مساهمات = درجة_الصلة(uid, بيانات_الصلة)
    كلمات = {}
    for ت in ملف["التعليقات_بالتفصيل"]:
        نص = (ت["نص"] or "").lower()
        for ك in re.findall(r'[\u0600-\u06FF]{3,}', نص):
            if ك in ("على","الى","إلى","هذا","هذه","كان","كانت","اللي","التي","الذي"): continue
            كلمات[ك] = كلمات.get(ك, 0) + 1
    أكثر_كلمات = sorted([{"كلمة": k, "عدد": v} for k, v in كلمات.items() if v >= 2], key=lambda x: -x["عدد"])[:15]
    أوقات = تحليل_أوقات([ف for ف in فيديوهات if any((ت.get("author") or {}).get("uniqueId") == uid for ت in ف.get("comments", []))], uid)
    return {
        "الهدف": مستخدم_الهدف, "الشخص": uid,
        "درجة_الصلة": درجة, "مساهمات_الدرجة": مساهمات,
        "إحصاءات": إحصاءات_تعليقات, "ملف": ملف,
        "منشن_هو_لهم": منشن_هو_لهم, "من_يذكره": من_يذكره,
        "عدد_منشن_للهدف": عدد_منشن_للهدف,
        "أكثر_كلمات": أكثر_كلمات, "أوقات_نشاط": أوقات,
    }

