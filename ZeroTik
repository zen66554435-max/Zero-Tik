def توليد_HTML(بيانات, نوع="ملف"):
    الآن = datetime.now().strftime("%Y-%m-%d %H:%M")
    h = f"""<!DOCTYPE html>
<html lang="ar" dir="rtl"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{الأداة} — {نوع}</title><style>{CSS}</style></head>
<body><div class="container">
<div class="header">
<h1>{الأداة}</h1>
<div class="team">{الفريق}</div>
<div class="meta">{نوع} · {الآن}</div>
</div>
"""
    if نوع == "ملف حساب":
        h += ملف_html(بيانات)
    elif نوع == "شبكة":
        h += شبكة_html(بيانات)
