def توليد_PDF(html, مسار):
    try:
        from playwright.sync_api import sync_playwright
        مسار_مؤقت = مسار.replace(".pdf", ".html")
        with open(مسار_مؤقت, "w", encoding="utf-8") as f:
            f.write(html)
        with sync_playwright() as p:
            متصفح = p.chromium.launch(headless=True, args=["--no-sandbox"])
            صفحة = متصفح.new_page()
            صفحة.goto(f"file://{os.path.abspath(مسار_مؤقت)}", wait_until="networkidle")
            صفحة.pdf(path=مسار, format="A4", print_background=True,
                    margin={"top":"15mm","bottom":"15mm","left":"15mm","right":"15mm"})
            متصفح.close()
        try: os.remove(مسار_مؤقت)
        except: pass
        return True
    except Exception as e:
        خطأ(f"PDF: {e}")
        return False

