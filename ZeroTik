def اعتراض_عميق(رابط_بداية, تمريرات=12, انتظار=1500, مهلة=40, chromium_path=None):
    from playwright.sync_api import sync_playwright
    مسؤول = {}
    إطلاق = {"headless": True, "args": ["--no-sandbox", "--disable-dev-shm-usage", "--disable-gpu"]}
    if _proxy: إطلاق["proxy"] = {"server": _proxy}
    if chromium_path: إطلاق["executable_path"] = chromium_path
    with sync_playwright() as p:
        متصفح = p.chromium.launch(**إطلاق)
        سياق = متصفح.new_context(
            user_agent=random.choice(وكلاء_المستخدم),
            locale="ar-SA",
            viewport={"width": 1280, "height": 2000},
        )
        صفحة = سياق.new_page()
        def عند_رد(رد):
            u = رد.url
            if "tiktok.com/api/" in u:
                try:
                    اسم = u.split("?")[0].rstrip("/").rsplit("/", 1)[-1]
                    مسؤول[اسم] = رد.json()
                except Exception: pass
        صفحة.on("response", عند_رد)
        صفحة.goto(رابط_بداية, wait_until="domcontentloaded", timeout=مهلة * 1000)
        صفحة.wait_for_timeout(3000)
        for _ in range(تمريرات):
            صفحة.mouse.wheel(0, 2500)
            صفحة.wait_for_timeout(انتظار)
            try:
                زر = صفحة.query_selector('button[aria-label="Close"], [data-e2e="modal-close-inner-button"]')
                if زر: زر.click()
            except Exception: pass
        متصفح.close()
    return مسؤول

