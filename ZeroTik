                    if len(النتيجة.get("recentVideos", [])) < عدد_فيديوهات:
                        معلومة(f"البيئة محدودة — {len(النتيجة.get('recentVideos', []))} فيديو من HTML")

            if عدد_تعليقات > 0 and النتيجة.get("recentVideos") and playwright_جاهز:
                معلومة("سحب التعليقات ...")
                for ف in النتيجة["recentVideos"]:
                    try:
                        ف["comments"] = جمع_تعليقات_فيديو(مستخدم, ف["id"], حد=عدد_تعليقات, chromium_path=chromium_path)
                    except Exception:
                        ف["comments"] = []
    except Exception as e:
        خطأ(str(e)); return 2

    if تصدير_json:
        نص = json.dumps(النتيجة, ensure_ascii=False, indent=2)
        طبع(نص)
    else:
        from io import StringIO
        مخزن = StringIO(); قديم = sys.stdout; sys.stdout = مخزن
        طباعة_عربية(النتيجة)
        sys.stdout = قديم
        نص = مخزن.getvalue()
        طبع(نص)

    if ملف_حفظ:
        with open(ملف_حفظ, "w", encoding="utf-8") as f:
            f.write(نص)
        if not تصدير_json: طبع(f"\n{أبيض}[✓]{صفر} حُفظ في: {ملف_حفظ}")
    return 0

if __name__ == "__main__":
    sys.exit(الرئيسية())
