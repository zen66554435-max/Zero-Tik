    if مسار: return True, مسار
    ok, _ = صامت(f"{sys.executable} -m playwright install chromium", مهلة=900)
    if ok and chromium_playwright(): return True, None
    return False, None

_proxy = None
def ضبط_البروكسي(ب):
    global _proxy
    _proxy = ب or None

def جالب():
    if _proxy:
        h = urllib.request.ProxyHandler({"http": _proxy, "https": _proxy})
        return urllib.request.build_opener(h)
    return urllib.request.build_opener()

def جلب_بسيط(رابط, محاولات=4):
    آخر = None
    فاتح = جالب()
    for i in range(محاولات):
        try:
            طلب = urllib.request.Request(رابط, headers={
                "User-Agent": random.choice(وكلاء_المستخدم),
                "Accept-Language": "ar,en;q=0.9",
                "Accept": "text/html,application/xhtml+xml",
            })
            with فاتح.open(طلب, timeout=25) as رد:
                if رد.status == 200:
                    return رد.read().decode("utf-8", errors="replace")
                آخر = f"HTTP {رد.status}"
        except Exception as e:
            آخر = str(e)
        time.sleep(1.5 * (i + 1))
    raise RuntimeError(f"فشل الجلب: {آخر}")

def استخراج_حالة(html):
    for وسم in ("__UNIVERSAL_DATA_FOR_REHYDRATION__", "SIGI_STATE"):
        م = re.search(r'id="' + وسم + r'"[^>]*>(.*?)</script>', html, re.S)
        if م:
            try: return json.loads(م.group(1))
            except json.JSONDecodeError: continue
    raise RuntimeError("لم يُعثر على البيانات المضمّنة")

