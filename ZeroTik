def pip_تثبيت(حزمة):
    for أمر in (f"{sys.executable} -m pip install --quiet --disable-pip-version-check {حزمة}",
                f"pip3 install --quiet {حزمة}",
                f"pip install --quiet {حزمة}"):
        ok, _ = صامت(أمر)
        if ok: return True
    return False

