def جمع_هاشتاج(اسم_وسم, حد=80):
    وسم = اسم_وسم.lstrip("#")
    مسؤول = اعتراض_عميق(f"https://www.tiktok.com/tag/{وسم}", تمريرات=12)
    تفاصيل = مسؤول.get("detail", {}) or {}
    ch = تفاصيل.get("challengeInfo", {}).get("challenge", {}) if isinstance(تفاصيل, dict) else {}
    إحصاءات = تفاصيل.get("challengeInfo", {}).get("stats", {}) if isinstance(تفاصيل, dict) else {}
    عناصر_بيانات = مسؤول.get("item_list", {}) or {}
    عناصر = عناصر_بيانات.get("itemList", []) if isinstance(عناصر_بيانات, dict) else []
    فيديوهات = []
    for ع in عناصر[:حد]:
        إ = ع.get("stats", {})
        م = ع.get("author", {})
        فيديوهات.append({
            "id": ع.get("id"), "desc": ع.get("desc"),
            "createTime": ع.get("createTime"),
            "playCount": إ.get("playCount"),
            "diggCount": إ.get("diggCount"),
            "commentCount": إ.get("commentCount"),
            "shareCount": إ.get("shareCount"),
            "author": {"uniqueId": م.get("uniqueId"), "nickname": م.get("nickname")},
        })
    return {
        "hashtag": {
            "challengeName": ch.get("challengeName") or وسم,
            "title": ch.get("challengeName") or وسم,
            "viewCount": إحصاءات.get("viewCount"),
            "videoCount": إحصاءات.get("videoCount"),
        },
        "recentVideos": فيديوهات,
    }

def طباعة_عربية(بيانات, عمق=0):
    فراغ = "    " * عمق
    for مفتاح, قيمة in بيانات.items():
        اسم = الحقول.get(مفتاح, مفتاح)
        if isinstance(قيمة, dict):
            طبع(f"{فراغ}{اسم}:")
            طباعة_عربية(قيمة, عمق + 1)
        elif isinstance(قيمة, list):
            if not قيمة: continue
            طبع(f"\n{فراغ}──── {اسم} ({len(قيمة)}) ────")
            for رقم, عنصر in enumerate(قيمة, 1):
                طبع(f"\n{فراغ}  [{رقم}]")
                if isinstance(عنصر, dict):
                    طباعة_عربية(عنصر, عمق + 2)
                else:
                    طبع(f"{فراغ}      {عنصر}")
        else:
            v = "—" if قيمة is None else قيمة
            طبع(f"{فراغ}{اسم:<18}: {v}")

def الرئيسية():
    طبع(الشعار)
    الهدف = سؤال("أدخل الهدف (@اسم أو #هاشتاج)")
    if not الهدف:
        خطأ("لم يُدخل هدف"); return 1

    وسم = الهدف.startswith("#")
    print()
    if وسم:
        طبع(بند(1, "هاشتاج فقط"))
        طبع(بند(2, "هاشتاج + فيديوهات"))
    else:
        طبع(بند(1, "ملف فقط"))
        طبع(بند(2, "ملف + فيديوهات"))
        طبع(بند(3, "ملف + فيديوهات + تعليقات"))
    طبع(بند(0, "خروج"))
    print()

    الاختيار = سؤال("اختر الرقم", "1")
    if الاختيار == "0": return 0

    عدد_فيديوهات = 0
    عدد_تعليقات = 0
    if not وسم:
        if الاختيار in ("2", "3"):
            عدد_فيديوهات = int(سؤال("كم فيديو", "20"))
        if الاختيار == "3":
            عدد_تعليقات = int(سؤال("كم تعليق لكل فيديو", "50"))
    else:
        if الاختيار == "2":
            عدد_فيديوهات = int(سؤال("كم فيديو من الوسم", "40"))

    تصدير_json = سؤال("تصدير JSON؟ (ن/ي)", "ن").lower() in ("ي", "y", "yes")
    ملف_حفظ = سؤال("حفظ إلى ملف (فراغ = لا)", "")

    النتيجة = {"الفريق": الفريق, "الإصدار": الإصدار}

    try:
        if وسم:
            معلومة(f"اعتراض تدفق الوسم {الهدف} ...")
            النتيجة["hashtag"] = جمع_هاشتاج(الهدف, حد=max(عدد_فيديوهات, 40))
        else:
            مستخدم = الهدف.lstrip("@").strip()
            معلومة(f"سحب ملف @{مستخدم} ...")
            html = جلب_بسيط(f"https://www.tiktok.com/@{مستخدم}")
            حالة = استخراج_حالة(html)
            النتيجة.update(تحليل_ملف(حالة, مستخدم))
            if عدد_فيديوهات > 0:
                معلومة(f"اعتراض {عدد_فيديوهات} فيديو ...")
                فيديوهات = جمع_فيديوهات_عميق(مستخدم, حد=عدد_فيديوهات)
                if فيديوهات:
                    النتيجة["recentVideos"] = فيديوهات
            if عدد_تعليقات > 0 and النتيجة.get("recentVideos"):
                معلومة("سحب التعليقات ...")
                for ف in النتيجة["recentVideos"]:
                    try:
                        ف["comments"] = جمع_تعليقات_فيديو(مستخدم, ف["id"], حد=عدد_تعليقات)
                    except Exception as e:
                        ف["comments"] = []
                        خطأ(f"تعليقات {ف['id']}: {e}")
    except Exception as e:
        خطأ(str(e)); return 2

    if تصدير_json:
        نص = json.dumps(النتيجة, ensure_ascii=False, indent=2)
        طبع(نص)
    else:
        from io import StringIO
        مخزن = StringIO(); قديم = sys.stdout; sys.stdout = مخزن
        طباعة_عربية(النتيجة)
        sys.stdout = قديم
        نص = مخزن.getvalue()
        طبع(نص)

    if ملف_حفظ:
        with open(ملف_حفظ, "w", encoding="utf-8") as f:
            f.write(نص)
        if not تصدير_json: طبع(f"\n{أبيض}[✓]{صفر} حُفظ في: {ملف_حفظ}")
    return 0

if __name__ == "__main__":
    sys.exit(الرئيسية())
