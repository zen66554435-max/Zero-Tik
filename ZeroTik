    مسؤول = اعتراض_عميق(f"https://www.tiktok.com/@{مستخدم}", تمريرات=10, chromium_path=chromium_path)
    بيانات = مسؤول.get("item_list") or مسؤول.get("itemList") or {}
    عناصر = بيانات.get("itemList", []) if isinstance(بيانات, dict) else []
