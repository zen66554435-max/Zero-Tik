                تحذير(f"العلاقات: {e}")
        بيانات = {"أ": ملف_أ, "ب": ملف_ب, "علاقات": علاقات}
        صيغة = اختيار_صيغة()
        if صيغة in ("html","both"):
            مسار = حفظ_نتيجة(بيانات, "مقارنة", f"{أ_اسم}_vs_{ب_اسم}", "html")
            نجاح(f"HTML: {مسار}")
        if صيغة in ("pdf","both"):
            مسار = حفظ_نتيجة(بيانات, "مقارنة", f"{أ_اسم}_vs_{ب_اسم}", "pdf")
            نجاح(f"PDF: {مسار}")
        حفظ_أرشيف(بيانات, f"مقارنة_{أ_اسم}_{ب_اسم}")
        return 0

    عنوان("الهدف")
    الهدف = سؤال("أدخل @اسم أو #هاشتاج")
    if not الهدف:
        خطأ("فارغ"); return 1
    وسم = الهدف.startswith("#")

    if الاختيار == "6" or وسم:
        if not playwright_جاهز:
            خطأ("الهاشتاج يتطلب Playwright/Chromium"); return 1
        معلومة(f"اعتراض تدفق #{الهدف.lstrip('#')} ...")
        try:
            بيانات = جمع_هاشتاج(الهدف, حد=80, chromium_path=chromium_path)
        except Exception as e:
            خطأ(str(e)); return 2
        صيغة = اختيار_صيغة()
        if صيغة in ("html","both"):
            مسار = حفظ_نتيجة(بيانات, "هاشتاج", الهدف, "html"); نجاح(f"HTML: {مسار}")
        if صيغة in ("pdf","both"):
            مسار = حفظ_نتيجة(بيانات, "هاشتاج", الهدف, "pdf"); نجاح(f"PDF: {مسار}")
        حفظ_أرشيف(بيانات, الهدف)
        return 0

    مستخدم = الهدف.lstrip("@").strip()

    if الاختيار == "1":
        معلومة(f"سحب @{مستخدم} ...")
        try:
            html = جلب_بسيط(f"https://www.tiktok.com/@{مستخدم}")
            بيانات = تحليل_ملف(استخراج_حالة(html), مستخدم)
        except Exception as e:
            خطأ(str(e)); return 2
        صيغة = اختيار_صيغة()
        if صيغة in ("html","both"):
            مسار = حفظ_نتيجة(بيانات, "ملف حساب", مستخدم, "html"); نجاح(f"HTML: {مسار}")
        if صيغة in ("pdf","both"):
            مسار = حفظ_نتيجة(بيانات, "ملف حساب", مستخدم, "pdf"); نجاح(f"PDF: {مسار}")
        حفظ_أرشيف(بيانات, مستخدم)
        return 0

    if الاختيار in ("2","3","4","5"):
        if not playwright_جاهز:
            تحذير("وضع محدود")
        عدد_فيديوهات = int(سؤال("كم فيديو", "25"))
        عدد_تعليقات = 100
        if الاختيار in ("3","4","5"):
            عدد_تعليقات = int(سؤال("كم تعليق/فيديو", "100"))

        معلومة("جلب الملف ...")
        try:
            html = جلب_بسيط(f"https://www.tiktok.com/@{مستخدم}")
            ملف = تحليل_ملف(استخراج_حالة(html), مستخدم)
        except Exception as e:
            خطأ(str(e)); return 2

        فيديوهات = []
        if playwright_جاهز:
            معلومة(f"اعتراض {عدد_فيديوهات} فيديو ...")
            try:
                فيديوهات = جمع_فيديوهات_عميق(مستخدم, حد=عدد_فيديوهات, chromium_path=chromium_path)
            except Exception as e:
                تحذير(f"فيديوهات: {e}")
        if فيديوهات:
            ملف["recentVideos"] = فيديوهات

        if الاختيار in ("3","4","5") and فيديوهات and playwright_جاهز:
            معلومة("سحب تعليقات ...")
            for ف in فيديوهات:
                try:
                    ف["comments"] = جمع_تعليقات_فيديو(مستخدم, ف["id"], حد=عدد_تعليقات,
                                                      chromium_path=chromium_path, مع_الردود=True)
                    طبع(f"    {باهت}· فيديو {ف['id'][:8]}: {len(ف['comments'])} تعليق{صفر}")
                except Exception:
                    ف["comments"] = []

        if الاختيار == "3":
            صيغة = اختيار_صيغة()
            if صيغة in ("html","both"):
                مسار = حفظ_نتيجة(ملف, "ملف حساب", مستخدم, "html"); نجاح(f"HTML: {مسار}")
            if صيغة in ("pdf","both"):
                مسار = حفظ_نتيجة(ملف, "ملف حساب", مستخدم, "pdf"); نجاح(f"PDF: {مسار}")
            حفظ_أرشيف(ملف, مستخدم)
            return 0

        if الاختيار == "4":
            معلومة("جلب المتابعين ...")
            متابعون = []
            متابَعون = []
            try:
                متابعون = جمع_قائمة_متابعين(مستخدم, "followers", 200, chromium_path)
                طبع(f"    {باهت}· {len(متابعون)} متابع{صفر}")
            except Exception as e: تحذير(f"متابعون: {e}")
            try:
                متابَعون = جمع_قائمة_متابعين(مستخدم, "following", 200, chromium_path)
                طبع(f"    {باهت}· {len(متابَعون)} يتابع{صفر}")
            except Exception as e: تحذير(f"متابَعون: {e}")
            تحليل = تحليل_الشبكة(ملف, متابعون, متابَعون, فيديوهات)
            عرض_ملخص_شبكة(تحليل)
            صيغة = اختيار_صيغة()
            if صيغة in ("html","both"):
                مسار = حفظ_نتيجة(تحليل, "شبكة", مستخدم, "html"); نجاح(f"HTML: {مسار}")
            if صيغة in ("pdf","both"):
                مسار = حفظ_نتيجة(تحليل, "شبكة", مستخدم, "pdf"); نجاح(f"PDF: {مسار}")
            حفظ_أرشيف(تحليل, f"{مستخدم}_شبكة")
            return 0

        if الاختيار == "5":
            عداد = {}
            for ف in فيديوهات:
                for ت in ف.get("comments", []):
                    uid = (ت.get("author") or {}).get("uniqueId")
                    if uid and uid != مستخدم:
                        عداد[uid] = عداد.get(uid, 0) + 1
            if not عداد:
                خطأ("لا تعليقات"); return 1
            مرتّب = sorted(عداد.items(), key=lambda x: -x[1])
            عنوان("المعلّقون")
            for i, (uid, عدد) in enumerate(مرتّب[:20], 1):
                طبع(f"  {أبيض}[{i}]{صفر} @{uid:<22} {عدد} تعليق")
            خ = سؤال("\nاختر رقم أو @اسم", "1")
            try:
                رقم = int(خ)
                uid = مرتّب[رقم - 1][0]
            except (ValueError, IndexError):
                uid = خ.lstrip("@").strip()
            معلومة(f"تحليل @{uid} ...")
            تقرير = ملف_فردي_كامل(uid, فيديوهات, مستخدم)
            عرض_ملخص_فردي(تقرير)
            صيغة = اختيار_صيغة()
            if صيغة in ("html","both"):
                مسار = حفظ_نتيجة(تقرير, "فردي", f"{مستخدم}_معلق_{uid}", "html"); نجاح(f"HTML: {مسار}")
            if صيغة in ("pdf","both"):
                مسار = حفظ_نتيجة(تقرير, "فردي", f"{مستخدم}_معلق_{uid}", "pdf"); نجاح(f"PDF: {مسار}")
            حفظ_أرشيف(تقرير, f"{مستخدم}_معلق_{uid}")
            return 0

    خطأ("اختيار غير معروف")
    return 1

