def طبع(s=""): print(s)
def خطأ(s): print(f"[خطأ] {s}", file=sys.stderr)
def معلومة(s): print(f"{أبيض}[*]{صفر} {s}")
def بند(رقم, نص): return f"{أبيض}[{رقم}]{صفر} {نص}"

def سؤال(نص, افتراضي=""):
    v = input(f"{أبيض}[?]{صفر} {نص}: ").strip()
    return v if v else افتراضي

def جلب_بسيط(رابط, محاولات=3):
    آخر = None
    for i in range(محاولات):
        try:
            طلب = urllib.request.Request(رابط, headers={
                "User-Agent": random.choice(وكلاء_المستخدم),
                "Accept-Language": "ar,en;q=0.9",
                "Accept": "text/html,application/xhtml+xml",
            })
            with urllib.request.urlopen(طلب, timeout=25) as رد:
                if رد.status == 200:
                    return رد.read().decode("utf-8", errors="replace")
                آخر = f"HTTP {رد.status}"
        except Exception as e:
            آخر = str(e)
        time.sleep(1.5 * (i + 1))
    raise RuntimeError(f"فشل الجلب: {آخر}")

def استخراج_حالة(html):
    for وسم in ("__UNIVERSAL_DATA_FOR_REHYDRATION__", "SIGI_STATE"):
        م = re.search(r'id="' + وسم + r'"[^>]*>(.*?)</script>', html, re.S)
        if م:
            try: return json.loads(م.group(1))
            except json.JSONDecodeError: continue
    raise RuntimeError("لم يُعثر على البيانات المضمّنة")

def تحليل_ملف(حالة, مستخدم):
    نطاق = حالة.get("__DEFAULT_SCOPE__", {})
    معلومات = نطاق.get("webapp.user-detail", {}).get("userInfo", {})
    مستخدم_ب = معلومات.get("user") or {}
    إحصاءات = معلومات.get("stats") or {}
    عناصر = معلومات.get("itemList") or []
    if not مستخدم_ب:
        وحدة = حالة.get("UserModule", {})
        مستخدم_ب = وحدة.get("users", {}).get(مستخدم, {})
        إحصاءات = وحدة.get("stats", {}).get(مستخدم, {})
        عناصر = وحدة.get("items", [])
    نتيجة = {
        "username": مستخدم, "id": مستخدم_ب.get("id"),
        "nickname": مستخدم_ب.get("nickname"),
        "signature": مستخدم_ب.get("signature"),
        "verified": مستخدم_ب.get("verified"),
        "privateAccount": مستخدم_ب.get("privateAccount"),
        "region": مستخدم_ب.get("region"),
        "createTime": مستخدم_ب.get("createTime"),
        "avatar": مستخدم_ب.get("avatarLarger") or مستخدم_ب.get("avatarMedium"),
        "followers": إحصاءات.get("followerCount"),
        "following": إحصاءات.get("followingCount"),
        "likes": إحصاءات.get("heartCount") or إحصاءات.get("heart"),
        "videos": إحصاءات.get("videoCount"),
        "diggCount": إحصاءات.get("diggCount"),
        "friendCount": إحصاءات.get("friendCount"),
    }
    فيديوهات = []
    for ع in عناصر:
        إ = ع.get("stats", {})
        فيديوهات.append({
            "id": ع.get("id"), "desc": ع.get("desc"),
            "createTime": ع.get("createTime"),
            "playCount": إ.get("playCount"), "diggCount": إ.get("diggCount"),
            "commentCount": إ.get("commentCount"), "shareCount": إ.get("shareCount"),
            "collectCount": إ.get("collectCount"),
            "duration": (ع.get("video") or {}).get("duration"),
        })
    نتيجة["recentVideos"] = فيديوهات
    return نتيجة

def اعتراض_عميق(رابط_بداية, تمريرات=12, انتظار=1500, مهلة=40):
    try:
        from playwright.sync_api import sync_playwright
    except ImportError:
        raise RuntimeError("Playwright غير مثبّت — شغّل: pip install playwright && playwright install chromium")
    مسؤول = {}
    with sync_playwright() as p:
        متصفح = p.chromium.launch(headless=True, args=["--no-sandbox"])
        سياق = متصفح.new_context(
            user_agent=random.choice(وكلاء_المستخدم),
            locale="ar-SA",
            viewport={"width": 1280, "height": 2000},
        )
        صفحة = سياق.new_page()
        def عند_رد(رد):
            u = رد.url
            if "tiktok.com/api/" in u:
                try:
                    اسم = u.split("?")[0].rstrip("/").rsplit("/", 1)[-1]
                    مسؤول[اسم] = رد.json()
                except Exception:
                    pass
        صفحة.on("response", عند_رد)
        صفحة.goto(رابط_بداية, wait_until="domcontentloaded", timeout=مهلة * 1000)
        صفحة.wait_for_timeout(3000)
        for _ in range(تمريرات):
            صفحة.mouse.wheel(0, 2500)
            صفحة.wait_for_timeout(انتظار)
            try:
                زر = صفحة.query_selector('button[aria-label="Close"], [data-e2e="modal-close-inner-button"]')
                if زر: زر.click()
            except Exception:
                pass
        متصفح.close()
    return مسؤول

def جمع_فيديوهات_عميق(مستخدم, حد=60):
    مسؤول = اعتراض_عميق(f"https://www.tiktok.com/@{مستخدم}", تمريرات=10)
    بيانات = مسؤول.get("item_list") or مسؤول.get("itemList") or {}
    عناصر = بيانات.get("itemList", []) if isinstance(بيانات, dict) else []
    نتيجة = []
    for ع in عناصر[:حد]:
        إ = ع.get("stats", {})
        نتيجة.append({
            "id": ع.get("id"), "desc": ع.get("desc"),
            "createTime": ع.get("createTime"),
            "playCount": إ.get("playCount"), "diggCount": إ.get("diggCount"),
            "commentCount": إ.get("commentCount"),
            "shareCount": إ.get("shareCount"),
            "collectCount": إ.get("collectCount"),
            "duration": (ع.get("video") or {}).get("duration"),
        })
    return نتيجة

