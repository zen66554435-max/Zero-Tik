def صامت(أمر, مهلة=180):
    try:
        ن = subprocess.run(أمر, shell=True, capture_output=True, text=True, timeout=مهلة)
        return ن.returncode == 0, (ن.stdout + ن.stderr).strip()
    except Exception as e:
        return False, str(e)

